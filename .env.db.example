# Database password for Supabase migrations
# Get this from: Supabase Dashboard → Project Settings → Database → Connection string
# The password is in the connection string after "postgresql://postgres:" and before "@"
#
# Example: If connection string is
#   postgresql://postgres:abc123@db.oicgpknsmtvcsjacymum.supabase.co:5432/postgres
# Then:
#   SUPABASE_DB_PASSWORD=abc123

SUPABASE_DB_PASSWORD=your-db-password-here
