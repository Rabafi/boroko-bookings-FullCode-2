# Environment variables for the Tsa Bonno online booking site
# Copy this file to .env and fill in the values.

# Supabase project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase anon/public API key
VITE_SUPABASE_ANON_KEY=

# Optional: Edge Function URL for sending confirmation emails
# Set this after deploying the send-booking-confirmation Edge Function
VITE_CONFIRMATION_EMAIL_FUNCTION_URL=

# Optional: Analytics endpoint for lightweight event tracking
# If left empty, analytics events are logged to console only
VITE_ANALYTICS_ENDPOINT=

# Optional: Robots meta tag (index, noindex)
# Defaults to "index" if not set
VITE_ROBOTS_META=index, follow
