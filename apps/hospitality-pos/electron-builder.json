{
  "appId": "com.boroko.hospitalitypos",
  "productName": "Tsa Bonno Restaurant & Bar POS",
  "publish": { "provider": "github", "owner": "Rabafi", "repo": "boroko-hospitality-pos-releases" },
  "artifactName": "Tsa-Bonno-Restaurant-Bar-POS-${version}-${arch}.${ext}",
  "icon": "src/main/assets/tsa-bonno-restaurant-bar-os-icon.ico",
  "win": {
    "icon": "src/main/assets/tsa-bonno-restaurant-bar-os-icon.ico",
    "target": [{ "target": "nsis", "arch": ["x64"] }]
  },
  "directories": { "output": "dist/hospitality-pos" },
  "asar": true,
  "files": [
    "out/hospitality-pos/**/*",
    "src/main/assets/**/*",
    "package.json",
    "!out/hospitality-pos/**/*.map",
    "!**/.claude/**",
    "!apps/**",
    "!packages/**",
    "!legacy-pos/**",
    "!booking-site/**",
    "!manager-pwa/**",
    "!marketing-site/**",
    "!tests/**",
    "!Playwright tests/**",
    "!supabase/**",
    "!docs/**"
  ],
  "extraResources": [
    { "from": "src/main/assets", "to": "assets" },
    { "from": "apps/hospitality-pos/product.json", "to": "product.json" }
  ],
  "extraMetadata": { "name": "boroko-hospitality-pos", "main": "out/hospitality-pos/main/index.js", "description": "Tsa Bonno Restaurant & Bar POS" },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": false,
    "shortcutName": "Tsa Bonno Restaurant & Bar POS",
    "uninstallDisplayName": "Tsa Bonno Restaurant & Bar POS",
    "installerIcon": "src/main/assets/tsa-bonno-restaurant-bar-os-icon.ico",
    "uninstallerIcon": "src/main/assets/tsa-bonno-restaurant-bar-os-icon.ico"
  }
}
