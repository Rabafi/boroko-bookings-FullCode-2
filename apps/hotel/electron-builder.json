{
  "appId": "com.boroko.hotel",
  "productName": "Tsa Bonno HotelOS",
  "publish": { "provider": "github", "owner": "Rabafi", "repo": "boroko-hotel-releases" },
  "artifactName": "Tsa-Bonno-HotelOS-${version}-${arch}.${ext}",
  "icon": "src/main/assets/tsa-bonno-hotelos-icon.ico",
  "win": {
    "icon": "src/main/assets/tsa-bonno-hotelos-icon.ico",
    "target": [{ "target": "nsis", "arch": ["x64"] }]
  },
  "directories": { "output": "dist/hotel" },
  "asar": true,
  "files": [
    "out/hotel/**/*",
    "src/main/assets/**/*",
    "package.json",
    "!out/hotel/**/*.map",
    "!**/.claude/**",
    "!apps/**",
    "!packages/**",
    "!legacy-pos/**",
    "!booking-site/**",
    "!manager-pwa/**",
    "!marketing-site/**",
    "!tests/**",
    "!Playwright tests/**",
    "!supabase/**",
    "!docs/**"
  ],
  "extraResources": [
    { "from": "src/main/assets", "to": "assets" },
    { "from": "apps/hotel/product.json", "to": "product.json" }
  ],
  "extraMetadata": { "name": "boroko-hotel", "main": "out/hotel/main/index.js", "description": "Tsa Bonno HotelOS" },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": false,
    "shortcutName": "Tsa Bonno HotelOS",
    "uninstallDisplayName": "Tsa Bonno HotelOS",
    "installerIcon": "src/main/assets/tsa-bonno-hotelos-icon.ico",
    "uninstallerIcon": "src/main/assets/tsa-bonno-hotelos-icon.ico"
  }
}
