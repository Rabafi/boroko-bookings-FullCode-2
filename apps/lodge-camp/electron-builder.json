{
  "appId": "com.boroko.bookings",
  "productName": "Boroko Bookings",
  "publish": { "provider": "github", "owner": "Rabafi", "repo": "boroko-bookings-releases" },
  "artifactName": "Boroko-Bookings-${version}-${arch}.${ext}",
  "directories": { "output": "dist/lodge-camp" },
  "asar": true,
  "files": [
    "out/**/*",
    "src/main/assets/**/*",
    "package.json",
    "!out/**/*.map",
    "!**/.claude/**",
    "!apps/**",
    "!packages/**",
    "!legacy-pos/**",
    "!booking-site/**",
    "!manager-pwa/**",
    "!marketing-site/**",
    "!tests/**",
    "!Playwright tests/**",
    "!supabase/**",
    "!docs/**"
  ],
  "extraResources": [
    { "from": "src/main/assets", "to": "assets" },
    { "from": "apps/lodge-camp/product.json", "to": "product.json" }
  ],
  "extraMetadata": { "name": "boroko-bookings", "main": "out/main/index.js" },
  "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": false, "deleteAppDataOnUninstall": false, "shortcutName": "Boroko Bookings", "uninstallDisplayName": "Boroko Bookings" }
}
