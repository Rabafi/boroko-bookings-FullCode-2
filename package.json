    "legacy-pos:dist:dir": "npm --prefix legacy-pos run dist:dir",
    "legacy-pos:dist:publish": "npm --prefix legacy-pos run dist:publish",
    "legacy-pos:release:patch": "npm --prefix legacy-pos run release:patch",
    "legacy-pos:release:minor": "npm --prefix legacy-pos run release:minor",
    "legacy-pos:release:major": "npm --prefix legacy-pos run release:major",
    "legacy-pos:release:publish": "npm --prefix legacy-pos run release:publish",
