{
  "name": "tsa-bonno-hospitalityos",
  "version": "1.5.5",
  "private": true,
  "type": "module",
  "description": "Tsa Bonno HospitalityOS desktop product workspace",
  "author": {
    "name": "Botswapelo Studios Pty Ltd"
  },
  "main": "scripts/electron-product-entry.cjs",
  "scripts": {
    "dev": "node ./scripts/product-app.mjs lodge-camp dev",
    "dev:lodging": "node ./scripts/product-app.mjs lodge-camp dev",
    "dev:hotel": "node ./scripts/product-app.mjs hotel dev",
    "dev:restaurant-bar": "node ./scripts/product-app.mjs hospitality-pos dev",
    "dev:desk-a": "node .\\scripts\\run-local-desk.mjs A",
    "dev:desk-b": "node .\\scripts\\run-local-desk.mjs B",
    "build": "node ./scripts/product-app.mjs lodge-camp build",
    "preview": "electron-vite preview",
    "test": "node .\\tests\\production-guardrails.test.mjs",
    "test:offline-pos-critical": "node .\\tests\\offline-pos-regression.test.mjs",
    "test:offline-queue-critical": "node .\\tests\\offline-queue-regression.test.mjs",
    "test:financial-integrity": "node .\\tests\\financial-integrity-regression.test.mjs",
    "test:customer-credit-reschedule": "node .\\tests\\customer-credit-reschedule-regression.test.mjs",
    "test:inventory-offline-sync": "node .\\tests\\inventory-offline-sync-regression.test.mjs",
    "test:import-critical": "node .\\tests\\import-system-regression.test.mjs",
    "test:phase0-tenant-guard": "node .\\tests\\integration\\phase0-test-tenant-guard.test.mjs",
    "test:release-behavior": "node .\\tests\\release-behavior.test.mjs",
    "test:release-architecture": "node .\\tests\\release-architecture.test.mjs",
    "test:enterprise": "node .\\tests\\run-enterprise-suite.mjs",
    "test:commercial": "node .\\tests\\commercial-catalog-authority.test.mjs",
    "test:restaurant": "node .\\tests\\run-restaurant-suite.mjs",
    "test:marketing-site": "node .\\tests\\marketing-site-contract.test.mjs",
    "test:brand-migration": "node .\\tests\\tsa-bonno-brand-migration.test.mjs",
    "audit:brand": "node .\\scripts\\audit-brand-migration.mjs",
    "audit:brand:strict": "node .\\scripts\\audit-brand-migration.mjs --strict",
    "test:pos-hardware-adapter": "node .\\tests\\pos-hardware-adapter.test.mjs",
    "test:bar": "node --test tests/bar-base-product.test.mjs tests/bar-mode-curation.test.mjs tests/bar-addon-bundles.test.mjs tests/bar-cashup-blind.test.mjs tests/bar-cashup-idempotency.test.mjs tests/bar-stock-aging.test.mjs tests/bar-stock-cost-safety.test.mjs tests/bar-payment-references.test.mjs",
    "build:hospitality-pos": "node ./scripts/product-app.mjs hospitality-pos build",
    "test:pos-rush": "node .\\tests\\pos-rush-simulation.test.mjs",
    "products:list": "node .\\scripts\\list-products.mjs",
    "workspace:check": "node .\\scripts\\verify-product-workspace.mjs",
    "test:products": "node .\\tests\\product-extraction.test.mjs",
    "audit:prod": "npm audit --omit=dev && npm --prefix manager-pwa audit --omit=dev && npm --prefix booking-site audit --omit=dev",
    "manager:install": "npm --prefix manager-pwa ci",
    "manager:lint": "npm --prefix manager-pwa run lint",
    "manager:build": "npm --prefix manager-pwa run build",
    "booking:install": "npm --prefix booking-site ci",
    "booking:test": "npm --prefix booking-site run test:run",
    "booking:build": "npm --prefix booking-site run build",
    "test:web-surfaces": "npm run manager:lint && npm run manager:build && npm run booking:test && npm run booking:build && npm run test:marketing-site",
    "test:e2e": "playwright test --config \"Playwright tests/playwright.config.cjs\"",
    "test:e2e:pwa": "playwright test --config \"Playwright tests/playwright.config.cjs\" --project=pwa",
    "test:e2e:booking-site": "playwright test --config \"Playwright tests/playwright.config.cjs\" --project=booking-site",
    "test:lodge-camp-blockers": "node .\\tests\\lodge-camp-release-blockers-repair.test.mjs",
    "pwa:deploy": "npx vercel --prod",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release:patch": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "release:all": "node ./scripts/release.mjs patch --remind-pwa",
    "release:build": "npm run build && electron-builder --win nsis --publish never",
    "release:dir:local": "npm run build && electron-builder --win dir --publish never --config.win.signAndEditExecutable=false",
    "release:build:local": "npm run build && electron-builder --win nsis --publish never --config.win.signAndEditExecutable=false",
    "release:publish": "node ./scripts/release.mjs publish",
    "release:compatibility:publish": "node ./scripts/release.mjs publish",
    "dist": "npm run build && electron-builder",
    "dist:publish": "npm run build && electron-builder --publish always",
    "icons:build": "node ./scripts/build-brand-assets.mjs",
    "marketing:capture": "node ./scripts/capture-marketing-real-screenshots.mjs",
    "marketing:images": "node ./scripts/build-marketing-images.mjs",
    "marketing:brochure": "node ./scripts/build-marketing-brochure.mjs",
    "postinstall": "electron-builder install-app-deps",
    "db:push": "node ./scripts/db-push.mjs",
    "db:lint": "node ./scratch/run-db-lint.mjs lint",
    "legacy-pos:install": "npm --prefix legacy-pos ci",
    "legacy-pos:dev": "npm --prefix legacy-pos run dev",
    "legacy-pos:build": "npm --prefix legacy-pos run build",
    "legacy-pos:dist": "npm --prefix legacy-pos run dist",
    "legacy-pos:dist:dir": "npm --prefix legacy-pos run dist:dir",
    "legacy-pos:dist:publish": "npm --prefix legacy-pos run dist:publish",
    "legacy-pos:release:patch": "npm --prefix legacy-pos run release:patch",
    "legacy-pos:release:minor": "npm --prefix legacy-pos run release:minor",
    "legacy-pos:release:major": "npm --prefix legacy-pos run release:major",
    "legacy-pos:release:publish": "npm --prefix legacy-pos run release:publish",
    "legacy-pos:test": "npm --prefix legacy-pos run test",
    "legacy-pos:db:probe": "npm --prefix legacy-pos run db:probe"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@electron-toolkit/utils": "^3.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "date-fns": "^3.3.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.344.0",
    "nodemailer": "^9.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "madge": "^8.0.0",
    "pg": "^8.21.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "supabase": "^2.96.0",
    "tailwindcss": "^3.4.1",
    "vite": "^7.3.3"
  },
  "overrides": {
    "js-yaml": "4.2.0",
    "undici": "7.28.0"
  },
  "build": {
    "appId": "com.boroko.bookings",
    "productName": "Tsa Bonno LodgingOS",
    "extraMetadata": {
      "main": "out/lodge-camp/main/index.js"
    },
    "asar": true,
    "artifactName": "Tsa-Bonno-LodgingOS-${version}-${arch}.${ext}",
    "icon": "src/main/assets/tsa-bonno-lodgingos-icon.ico",
    "publish": {
      "provider": "github",
      "owner": "Rabafi",
      "repo": "boroko-bookings-releases"
    },
    "win": {
      "icon": "src/main/assets/tsa-bonno-lodgingos-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "npmRebuild": false,
    "compression": "maximum",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tsa Bonno LodgingOS",
      "uninstallDisplayName": "Tsa Bonno LodgingOS",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "src/main/assets/tsa-bonno-lodgingos-icon.ico",
      "uninstallerIcon": "src/main/assets/tsa-bonno-lodgingos-icon.ico",
      "include": "src/main/installer.nsh"
    },
    "files": [
      "out/lodge-camp/**/*",
      "src/main/assets/**/*",
      "!out/lodge-camp/**/*.map",
      "!**/*.{iml,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,__pycache__,thumbs.db,.gitignore,.gitattributes}",
      "!**/{__tests__,test,tests,powered-test}",
      "!**/node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "src/main/assets",
        "to": "assets"
      }
    ],
    "directories": {
      "output": "dist"
    }
  }
}
