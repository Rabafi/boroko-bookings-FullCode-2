    "@electron-toolkit/utils": "^3.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "chrono-node": "^2.10.1",
    "date-fns": "^3.3.1",
    "electron-updater": "^6.8.9",
    "fuse.js": "^7.5.0",
    "lucide-react": "^0.577.0",
    "nodemailer": "^10.0.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "24.19.1",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.18",
    "electron": "^42.10.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "madge": "^8.0.0",
    "pg": "^8.21.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "supabase": "^2.119.0",
    "tailwindcss": "^3.4.1",
    "typescript": "5.9.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "undici": "7.29.1"
  },
  "build": {
    "appId": "com.boroko.bookings",
    "productName": "Tsa Bonno LodgingOS",
    "extraMetadata": {
      "main": "out/lodge-camp/main/index.js"
    },
    "asar": true,
    "artifactName": "Tsa-Bonno-LodgingOS-${version}-${arch}.${ext}",
    "icon": "src/main/assets/tsa-bonno-lodgingos-icon.ico",
    "publish": {
      "provider": "github",
      "owner": "Rabafi",
      "repo": "boroko-bookings-releases"
    },
    "win": {
      "icon": "src/main/assets/tsa-bonno-lodgingos-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "npmRebuild": false,
    "compression": "maximum",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tsa Bonno LodgingOS",
      "uninstallDisplayName": "Tsa Bonno LodgingOS",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "src/main/assets/tsa-bonno-lodgingos-icon.ico",
      "uninstallerIcon": "src/main/assets/tsa-bonno-lodgingos-icon.ico",
      "include": "src/main/installer.nsh"
    },
    "files": [
      "out/lodge-camp/**/*",
      "src/main/assets/**/*",
      "!out/lodge-camp/**/*.map",
      "!**/*.{iml,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,__pycache__,thumbs.db,.gitignore,.gitattributes}",
      "!**/{__tests__,test,tests,powered-test}",
      "!**/node_modules/.cache"
    ],
    "extraResources": [
      {
        "from": "src/main/assets",
        "to": "assets"
      }
    ],
    "directories": {
      "output": "dist"
    }
  }
}
