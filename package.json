    "test:e2e:pwa": "playwright test --config \"Playwright tests/playwright.config.cjs\" --project=pwa",
    "test:e2e:booking-site": "playwright test --config \"Playwright tests/playwright.config.cjs\" --project=booking-site",
    "test:lodge-camp-blockers": "node .\\tests\\lodge-camp-release-blockers-repair.test.mjs",
