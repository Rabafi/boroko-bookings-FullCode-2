    "test:queue-replay-authority": "node --test tests/queue-replay-authority.test.mjs",
    "test:property-transition-db": "node -e \"if(!process.env.LUNA_REMEDIATION_TEST_DB_URL){console.error('BLOCKED: property-transition disposable database was NOT tested — set LUNA_REMEDIATION_TEST_DB_URL (+ LUNA_REMEDIATION_TARGET_MARKER=LUNA-REMEDIATION-DISPOSABLE-v1, LUNA_REMEDIATION_EXPECTED_DATABASE, LUNA_REMEDIATION_EXPECTED_PROJECT_REF); refusing green DB acceptance');process.exit(2)}\" && node scripts/verify-property-transitions-disposable.mjs",
