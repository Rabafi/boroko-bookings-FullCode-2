# Dedicated owner projection and ingestion service. Never point this service at
# the local Bar trading database or a Supabase/PostgREST project.
BAR_OWNER_DB_HOST=127.0.0.1
BAR_OWNER_DB_PORT=5432
BAR_OWNER_DB_NAME=bar_owner_receiver
BAR_OWNER_DB_USER=bar_owner_receiver_runtime
BAR_OWNER_DB_PASSWORD=replace-with-a-secret-from-the-secret-manager
BAR_OWNER_MASTER_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Public callback and the existing Manager PWA origin.
BAR_OWNER_PUBLIC_URL=https://bar-owner.example.invalid
BAR_OWNER_PWA_ORIGIN=https://manager.example.invalid
BAR_OWNER_HOST=0.0.0.0
BAR_OWNER_PORT=8792
BAR_OWNER_TLS_CERT=C:\\secrets\\bar-owner-fullchain.pem
BAR_OWNER_TLS_KEY=C:\\secrets\\bar-owner-private-key.pem

# HTTPS mail webhook contract: POST {to, template: "bar_owner_verification",
# verification_url}; configure it to deliver a verification link to the owner.
BAR_OWNER_EMAIL_WEBHOOK_URL=https://mail.example.invalid/send-template
BAR_OWNER_EMAIL_WEBHOOK_TOKEN=replace-with-a-mail-webhook-token
