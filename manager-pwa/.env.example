VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# ANON PUBLIC key only — never the service_role key in this file
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Must also be allowed in Supabase Authentication -> URL Configuration -> Redirect URLs.
VITE_AUTH_REDIRECT_URL=https://manager.tsabonno.com/reset-password

VITE_VAPID_PUBLIC_KEY=<vapid-public-key>

# Optional separate, read-only Bar owner projection API. Must be HTTPS outside local development.
VITE_BAR_OWNER_API_URL=https://<bar-owner-receiver-host>
