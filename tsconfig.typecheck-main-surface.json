{
  "extends": "./tsconfig.typecheck-main.json",
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": false,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "exactOptionalPropertyTypes": true
  },
  "files": [],
  "include": ["src/main/**/*.js"],
  "exclude": ["src/main/assets/**"]
}
