{
  "name": "@tsa-bonno/pos-legacy",
  "version": "1.1.0",
  "type": "module",
  "description": "Tsa Bonno POS Legacy for Windows Embedded POSReady 7",
  "author": {
    "name": "Botswapelo Studios Pty Ltd"
  },
  "main": "out/main/index.cjs",
  "scripts": {
    "prepare:config": "node ./scripts/prepare-runtime-config.mjs",
    "dev": "npm run prepare:config && electron-vite dev",
    "build": "npm run prepare:config && electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win nsis --ia32 --publish never",
    "dist:dir": "npm run build && electron-builder --win dir --ia32 --publish never",
    "dist:publish": "npm run build && electron-builder --win nsis --ia32 --publish always",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release:patch": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "release:publish": "node ./scripts/release.mjs publish",
    "test": "node ./tests/legacy-pos-regression.test.mjs",
    "db:probe": "node ./scripts/probe-database-contract.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.39.0",
    "bcryptjs": "^2.4.3",
    "cross-fetch": "^3.2.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.344.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.22.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.18",
    "electron": "^22.3.27",
    "electron-builder": "^23.6.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.boroko.poslegacy",
    "productName": "Tsa Bonno POS Legacy",
    "asar": true,
    "artifactName": "Tsa-Bonno-POS-Legacy-${version}-${arch}.${ext}",
    "icon": "src/main/assets/icon.ico",
    "publish": {
      "provider": "github",
      "owner": "Rabafi",
      "repo": "boroko-pos-legacy-releases"
    },
    "win": {
      "icon": "src/main/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Tsa Bonno POS Legacy",
      "uninstallDisplayName": "Tsa Bonno POS Legacy",
      "installerIcon": "src/main/assets/icon.ico",
      "uninstallerIcon": "src/main/assets/icon.ico"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/generated/legacy-pos-runtime-config.json",
        "to": "legacy-pos-runtime-config.json"
      }
    ],
    "directories": {
      "output": "dist"
    }
  }
}
