# ── Supabase (Electron desktop app) ──────────────────────────────────────────
# These two values are baked into the app binary at build time by electron-vite.
# They are NOT secrets — the anon key is Supabase's public-facing key — but
# keeping them here means they are not committed to source control and can be
# rotated without a code change.
#
# Get both values from:
#   Supabase Dashboard → Settings → API
#     • Project URL         → VITE_SUPABASE_URL
#     • anon / public key   → VITE_SUPABASE_KEY

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_KEY=<anon-public-key>

# ── Service-role key (Command Central admin machine ONLY) ─────────────────────
# SECRET — never put this in .env or source code.
# Set as an OS environment variable on the admin machine only.
# Lodge customer machines must NOT have this set.
#
#   Windows PowerShell:
#     [System.Environment]::SetEnvironmentVariable('SUPABASE_SERVICE_ROLE_KEY','<key>','User')
#   macOS / Linux (add to ~/.zshrc or ~/.bashrc):
#     export SUPABASE_SERVICE_ROLE_KEY='<key>'
#
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   ← leave this line commented out
